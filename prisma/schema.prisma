// UMS - University Management System
// Complete Prisma Schema - All 230+ Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE: Organization, Team, User, Role, Permission
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String?  @unique
  logo      String?
  address   String?
  phone     String?
  email     String?
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]

  @@map("organizations")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String?
  logo           String?
  address        String?
  phone          String?
  email          String?
  website        String?
  timezone       String       @default("Asia/Kolkata")
  currency       String       @default("INR")
  locale         String       @default("en")
  isActive       Boolean      @default(true)
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users                UserTeam[]
  academicSessions     AcademicSession[]
  departments          Department[]
  programTypes         ProgramType[]
  programs             Program[]
  divisions            Division[]
  courses              Course[]
  batches              Batch[]
  subjects             Subject[]
  students             Student[]
  guardians            Guardian[]
  employees            Employee[]
  feeGroups            FeeGroup[]
  feeHeads             FeeHead[]
  examTerms            ExamTerm[]
  transportCircles     TransportCircle[]
  vehicles             Vehicle[]
  books                Book[]
  hostelBlocks         HostelBlock[]
  inventories          Inventory[]
  menuItems            MenuItem[]
  announcements        Announcement[]
  events               Event[]
  holidays             Holiday[]
  blogPosts            BlogPost[]
  newsArticles         NewsArticle[]
  galleries            Gallery[]
  customForms          CustomForm[]
  approvalTypes        ApprovalType[]
  tasks                Task[]
  tickets              Ticket[]
  posts                Post[]
  conversations        Conversation[]
  jobVacancies         JobVacancy[]
  sitePages            SitePage[]
  siteMenus            SiteMenu[]
  systemConfigs        SystemConfig[]
  moduleConfigs        ModuleConfig[]
  options              Option[]
  customFields         CustomField[]
  locales              Locale[]
  todos                Todo[]
  backups              Backup[]
  activityLogs         ActivityLog[]
  ipRules              IpRule[]
  classTimings         ClassTiming[]
  timetables           Timetable[]
  ledgerTypes          LedgerType[]
  ledgers              Ledger[]
  paymentMethods       PaymentMethod[]
  transactions         FinancialTransaction[]
  serviceAllocations   ServiceAllocation[]
  certificateTemplates CertificateTemplate[]
  idCardTemplates      IdCardTemplate[]
  onlineExams          OnlineExam[]
  complaints           Complaint[]
  visitorLogs          VisitorLog[]
  gatePasses           GatePass[]
  callLogs             CallLog[]
  mailTemplates        MailTemplate[]
  smsTemplates         SmsTemplate[]
  whatsappTemplates    WhatsappTemplate[]
  pushTemplates        PushTemplate[]
  trips                Trip[]
  incidents            Incident[]
  enquiries            Enquiry[]

  @@map("teams")
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  username            String?    @unique
  password            String
  firstName           String
  lastName            String?
  phone               String?
  avatar              String?
  scope               UserScope  @default(ADMIN)
  status              UserStatus @default(ACTIVE)
  emailVerified       Boolean    @default(false)
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean    @default(false)
  twoFactorSecret     String?
  forcePasswordChange Boolean    @default(false)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  screenLockedAt      DateTime?
  screenLockPin       String?
  refreshToken        String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  teams               UserTeam[]
  roles               UserRole[]
  permissions         UserPermission[]
  loginAttempts       LoginAttempt[]
  accessLogs          UserAccessLog[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  remindersCreated    Reminder[]            @relation("ReminderCreator")
  reminderAssignments ReminderUser[]
  deviceTokens        DeviceToken[]
  chatParticipations  ChatParticipant[]
  chatMessages        ChatMessage[]
  posts               Post[]
  postComments        PostComment[]
  taskMemberships     TaskMember[]
  todosCreated        Todo[]
  sentCommunications  CommunicationRecord[]
  impersonatedBy      Impersonation[]       @relation("ImpersonatedUser")
  impersonating       Impersonation[]       @relation("ImpersonatingUser")

  student  Student?
  guardian Guardian?
  employee Employee?

  @@map("users")
}

enum UserScope {
  ADMIN
  STUDENT
  GUARDIAN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model UserTeam {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@map("user_teams")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  ipAddress String
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@map("login_attempts")
}

model UserAccessLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("user_access_logs")
}

model Impersonation {
  id             String    @id @default(uuid())
  impersonatorId String
  impersonatedId String
  impersonator   User      @relation("ImpersonatingUser", fields: [impersonatorId], references: [id])
  impersonated   User      @relation("ImpersonatedUser", fields: [impersonatedId], references: [id])
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  ipAddress      String?

  @@map("impersonations")
}

model IpRule {
  id        String     @id @default(uuid())
  teamId    String
  team      Team       @relation(fields: [teamId], references: [id])
  ipAddress String
  type      IpRuleType
  reason    String?
  createdAt DateTime   @default(now())

  @@map("ip_rules")
}

enum IpRuleType {
  WHITELIST
  BLACKLIST
}

model OtpToken {
  id        String   @id @default(uuid())
  email     String
  phone     String?
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_tokens")
}

enum OtpType {
  LOGIN
  EMAIL_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
}

// ============================================================
// ACADEMIC MODULE
// ============================================================

model AcademicSession {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  shortName   String?
  startDate   DateTime
  endDate     DateTime
  isDefault   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  periods        Period[]
  enquiries      Enquiry[]
  registrations  Registration[]
  studentRecords StudentRecord[]

  @@map("academic_sessions")
}

model Period {
  id                String          @id @default(uuid())
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  name              String
  shortName         String?
  startDate         DateTime
  endDate           DateTime
  isArchived        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("periods")
}

model ProgramType {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  name      String
  code      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[]

  @@map("program_types")
}

model Department {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  code        String?
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programs            Program[]
  employees           Employee[]
  employeeDepartments EmployeeDepartment[]

  @@map("departments")
}

model Program {
  id            String       @id @default(uuid())
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id])
  programTypeId String?
  programType   ProgramType? @relation(fields: [programTypeId], references: [id])
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  name          String
  code          String?
  shortName     String?
  position      Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  divisions Division[]
  courses   Course[]

  @@map("programs")
}

model Division {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  name      String
  code      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@map("divisions")
}

model Course {
  id          String    @id @default(uuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id])
  programId   String
  program     Program   @relation(fields: [programId], references: [id])
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id])
  name        String
  code        String?
  shortName   String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batches         Batch[]
  subjectRecords  SubjectRecord[]
  feeStructures   FeeStructure[]
  enquiryRecords  EnquiryRecord[]
  enrollmentSeats EnrollmentSeat[]
  bookLists       BookList[]

  @@map("courses")
}

model Batch {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  name        String
  code        String?
  maxStrength Int?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectRecords   SubjectRecord[]
  studentRecords   StudentRecord[]
  feeStructures    FeeStructure[]
  timetableRecords TimetableRecord[]
  examSchedules    ExamSchedule[]

  @@map("batches")
}

model Subject {
  id            String       @id @default(uuid())
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id])
  name          String
  code          String?
  shortName     String?
  subjectTypeId String?
  subjectType   SubjectType? @relation(fields: [subjectTypeId], references: [id])
  description   String?
  position      Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subjectRecords   SubjectRecord[]
  subjectIncharges SubjectIncharge[]

  @@map("subjects")
}

model SubjectType {
  id        String   @id @default(uuid())
  name      String
  code      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]

  @@map("subject_types")
}

model SubjectRecord {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id])
  isElective  Boolean  @default(false)
  maxMarks    Float?
  passMarks   Float?
  creditHours Float?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjectIncharges SubjectIncharge[]
  studentSubjects  StudentSubject[]

  @@map("subject_records")
}

model SubjectIncharge {
  id              String        @id @default(uuid())
  subjectRecordId String
  subjectRecord   SubjectRecord @relation(fields: [subjectRecordId], references: [id])
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id])
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("subject_incharges")
}

model StudentSubject {
  id              String        @id @default(uuid())
  studentRecordId String
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id])
  subjectRecordId String
  subjectRecord   SubjectRecord @relation(fields: [subjectRecordId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([studentRecordId, subjectRecordId])
  @@map("student_subjects")
}

model ClassTiming {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions ClassTimingSession[]

  @@map("class_timings")
}

model ClassTimingSession {
  id            String      @id @default(uuid())
  classTimingId String
  classTiming   ClassTiming @relation(fields: [classTimingId], references: [id], onDelete: Cascade)
  name          String
  startTime     String
  endTime       String
  isBreak       Boolean     @default(false)
  position      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@map("class_timing_sessions")
}

model EnrollmentSeat {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  totalSeats    Int
  filledSeats   Int      @default(0)
  reservedSeats Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("enrollment_seats")
}

model BookList {
  id         String   @id @default(uuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  title      String
  author     String?
  publisher  String?
  isbn       String?
  price      Float?
  isRequired Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("book_lists")
}

// ============================================================
// STUDENT MODULE
// ============================================================

model Enquiry {
  id                String           @id @default(uuid())
  teamId            String
  academicSessionId String?
  team              Team             @relation(fields: [teamId], references: [id])
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])
  enquiryNumber     String?          @unique
  firstName         String
  lastName          String?
  email             String?
  phone             String?
  dateOfBirth       DateTime?
  gender            Gender?
  address           String?
  city              String?
  state             String?
  country           String?
  zipCode           String?
  guardianName      String?
  guardianPhone     String?
  guardianEmail     String?
  guardianRelation  String?
  source            String?
  type              String?
  stage             String?          @default("New")
  assignedToId      String?
  assignedTo        Employee?        @relation("EnquiryAssigned", fields: [assignedToId], references: [id])
  remarks           String?
  isConverted       Boolean          @default(false)
  convertedToId     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  records   EnquiryRecord[]
  followups EnquiryFollowup[]

  @@map("enquiries")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model EnquiryRecord {
  id        String   @id @default(uuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  remarks   String?
  createdAt DateTime @default(now())

  @@map("enquiry_records")
}

model EnquiryFollowup {
  id           String    @id @default(uuid())
  enquiryId    String
  enquiry      Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  followupDate DateTime
  nextFollowup DateTime?
  status       String?
  remarks      String?
  followedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("enquiry_followups")
}

model Registration {
  id                 String           @id @default(uuid())
  teamId             String
  academicSessionId  String?
  academicSession    AcademicSession? @relation(fields: [academicSessionId], references: [id])
  registrationNumber String?          @unique
  firstName          String
  lastName           String?
  email              String?
  phone              String?
  dateOfBirth        DateTime?
  gender             Gender?
  bloodGroup         String?
  religion           String?
  caste              String?
  category           String?
  nationality        String?
  motherTongue       String?
  address            String?
  city               String?
  state              String?
  country            String?
  zipCode            String?
  photo              String?
  stage              String?          @default("Pending")
  isVerified         Boolean          @default(false)
  verifiedAt         DateTime?
  verifiedById       String?
  isConverted        Boolean          @default(false)
  convertedToId      String?
  remarks            String?
  customFields       Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  fees      RegistrationFee[]
  guardians RegistrationGuardian[]
  documents RegistrationDocument[]

  @@map("registrations")
}

model RegistrationFee {
  id             String        @id @default(uuid())
  registrationId String
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  amount         Float
  paidAmount     Float         @default(0)
  dueDate        DateTime?
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  transactionId  String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("registration_fees")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

model RegistrationGuardian {
  id             String       @id @default(uuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String?
  relation       String
  phone          String?
  email          String?
  occupation     String?
  address        String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("registration_guardians")
}

model RegistrationDocument {
  id             String       @id @default(uuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  type           String?
  filePath       String
  createdAt      DateTime     @default(now())

  @@map("registration_documents")
}

model Student {
  id               String    @id @default(uuid())
  teamId           String
  team             Team      @relation(fields: [teamId], references: [id])
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id])
  admissionNumber  String?   @unique
  rollNumber       String?
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  dateOfBirth      DateTime?
  gender           Gender?
  bloodGroup       String?
  religion         String?
  caste            String?
  category         String?
  nationality      String?
  motherTongue     String?
  photo            String?
  fatherName       String?
  motherName       String?
  address          String?
  permanentAddress String?
  city             String?
  state            String?
  country          String?
  zipCode          String?
  emergencyContact String?
  emergencyPhone   String?
  admissionDate    DateTime?
  admissionType    String?   @default("Regular")
  isProvisional    Boolean   @default(false)
  enrollmentStatus String?   @default("Active")
  mentorId         String?
  mentor           Employee? @relation("StudentMentor", fields: [mentorId], references: [id])
  customFields     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  records               StudentRecord[]
  documents             StudentDocument[]
  qualifications        StudentQualification[]
  accounts              StudentAccount[]
  healthRecords         StudentHealthRecord[]
  tags                  StudentTagAssignment[]
  guardians             StudentGuardian[]
  fees                  StudentFee[]
  feePayments           FeePayment[]
  attendances           StudentAttendance[]
  examRecords           ExamRecord[]
  clockRecords          StudentClockRecord[]
  leaveRequests         StudentLeaveRequest[]
  diaryEntries          Diary[]
  assignmentSubmissions AssignmentSubmission[]
  onlineExamSubmissions OnlineExamSubmission[]
  enrollmentLogs        EnrollmentLog[]
  transferRequests      TransferRequest[]
  certificates          Certificate[]
  idCards               IdCard[]
  roomAllocations       RoomAllocation[]
  transportPassengers   TransportRoutePassenger[]
  bookIssues            BookIssue[]
  incidents             IncidentStudent[]
  tripParticipants      TripParticipant[]
  serviceRequests       ServiceRequest[]
  dialogues             Dialogue[]
  contactEditRequests   ContactEditRequest[]

  @@map("students")
}

model StudentRecord {
  id                String          @id @default(uuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  batchId           String
  batch             Batch           @relation(fields: [batchId], references: [id])
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean         @default(true)
  remarks           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  studentSubjects StudentSubject[]

  @@map("student_records")
}

model StudentDocument {
  id             String    @id @default(uuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id])
  name           String
  type           String?
  documentNumber String?
  filePath       String
  expiryDate     DateTime?
  isVerified     Boolean   @default(false)
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("student_documents")
}

model StudentQualification {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  level       String
  institute   String?
  board       String?
