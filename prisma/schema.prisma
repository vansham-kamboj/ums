model Post {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  media     Json?
  audience  Json?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments PostComment[]

  @@map("posts")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("post_comments")
}

// ============================================================
// CHAT MODULE
// ============================================================

model Conversation {
  id        String           @id @default(uuid())
  teamId    String
  team      Team             @relation(fields: [teamId], references: [id])
  title     String?
  type      ConversationType @default(DIRECT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("conversations")
}

enum ConversationType {
  DIRECT
  GROUP
}

model ChatParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  message        String
  attachments    Json?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("chat_messages")
}

// ============================================================
// NOTIFICATION & REMINDER MODULE
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String?
  type      String?
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model Reminder {
  id           String   @id @default(uuid())
  createdById  String
  createdBy    User     @relation("ReminderCreator", fields: [createdById], references: [id])
  title        String
  description  String?
  reminderDate DateTime
  reminderTime String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users ReminderUser[]

  @@map("reminders")
}

model ReminderUser {
  id         String   @id @default(uuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  isNotified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([reminderId, userId])
  @@map("reminder_users")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  platform   String?
  deviceInfo Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("device_tokens")
}

// ============================================================
// SERVICE REQUEST & DIALOGUE MODULE
// ============================================================

model ServiceAllocation {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  description String?
  type        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ServiceRequest[]

  @@map("service_allocations")
}

model ServiceRequest {
  id                  String            @id @default(uuid())
  serviceAllocationId String
  serviceAllocation   ServiceAllocation @relation(fields: [serviceAllocationId], references: [id])
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id])
  subject             String
  description         String?
  status              String            @default("Pending")
  resolvedAt          DateTime?
  resolvedById        String?
  remarks             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("service_requests")
}

model Dialogue {
  id            String    @id @default(uuid())
  studentId     String?
  student       Student?  @relation(fields: [studentId], references: [id])
  employeeId    String?
  category      String?
  subject       String
  message       String
  response      String?
  status        String    @default("Open")
  respondedById String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("dialogues")
}

model ContactEditRequest {
  id           String         @id @default(uuid())
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id])
  fieldName    String
  oldValue     String?
  newValue     String
  reason       String?
  status       ApprovalStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  remarks      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("contact_edit_requests")
}

// ============================================================
// CERTIFICATE & ID CARD MODULE
// ============================================================

model CertificateTemplate {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  name      String
  type      String?
  layout    Json
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificates Certificate[]

  @@map("certificate_templates")
}

model Certificate {
  id         String              @id @default(uuid())
  templateId String
  template   CertificateTemplate @relation(fields: [templateId], references: [id])
  studentId  String?
  student    Student?            @relation(fields: [studentId], references: [id])
  employeeId String?
  number     String              @unique
  data       Json?
  issuedAt   DateTime            @default(now())
  createdAt  DateTime            @default(now())

  @@map("certificates")
}

model IdCardTemplate {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  name      String
  type      String?
  layout    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idCards IdCard[]

  @@map("id_card_templates")
}

model IdCard {
  id         String         @id @default(uuid())
  templateId String
  template   IdCardTemplate @relation(fields: [templateId], references: [id])
  studentId  String?
  student    Student?       @relation(fields: [studentId], references: [id])
  guardianId String?
  guardian   Guardian?      @relation(fields: [guardianId], references: [id])
  employeeId String?
  data       Json?
  issuedAt   DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@map("id_cards")
}

// ============================================================
// PAYMENT GATEWAY MODULE
// ============================================================

model PaymentGatewayConfig {
  id         String   @id @default(uuid())
  name       String
  provider   String
  config     Json
  isActive   Boolean  @default(false)
  isTestMode Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payment_gateway_configs")
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  gateway       String
  orderId       String?  @unique
  transactionId String?
  amount        Float
  currency      String   @default("INR")
  status        String   @default("Pending")
  payerName     String?
  payerEmail    String?
  payerPhone    String?
  metadata      Json?
  responseData  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_transactions")
}

// ============================================================
// WEBSITE / CMS MODULE
// ============================================================

model SitePage {
  id              String   @id @default(uuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  title           String
  slug            String
  content         String?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  blocks SiteBlock[]

  @@unique([teamId, slug])
  @@map("site_pages")
}

model SiteMenu {
  id        String     @id @default(uuid())
  teamId    String
  team      Team       @relation(fields: [teamId], references: [id])
  title     String
  url       String?
  pageId    String?
  parentId  String?
  parent    SiteMenu?  @relation("MenuTree", fields: [parentId], references: [id])
  children  SiteMenu[] @relation("MenuTree")
  position  Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("site_menus")
}

model SiteBlock {
  id        String   @id @default(uuid())
  pageId    String
  page      SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  content   Json
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_blocks")
}

model WebsiteConfig {
  id         String   @id @default(uuid())
  teamId     String?
  isEnabled  Boolean  @default(false)
  theme      String   @default("default")
  colorTheme String?  @default("blue")
  customCss  String?
  logo       String?
  favicon    String?
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("website_configs")
}

// ============================================================
// CONFIGURATION & SETTINGS MODULE
// ============================================================

model SystemConfig {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  key       String
  value     String?
  type      String?  @default("string")
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, key])
  @@map("system_configs")
}

model ModuleConfig {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  module    String
  isEnabled Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, module])
  @@map("module_configs")
}

model Locale {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  code      String
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations LocaleTranslation[]

  @@unique([teamId, code])
  @@map("locales")
}

model LocaleTranslation {
  id        String   @id @default(uuid())
  localeId  String
  locale    Locale   @relation(fields: [localeId], references: [id], onDelete: Cascade)
  key       String
  value     String
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([localeId, key])
  @@map("locale_translations")
}

model CustomField {
  id         String   @id @default(uuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  form       String
  label      String
  name       String
  type       String
  options    Json?
  isRequired Boolean  @default(false)
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("custom_fields")
}

model Option {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  type      String
  name      String
  slug      String?
  module    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OptionItem[]

  @@unique([teamId, type])
  @@map("options")
}

model OptionItem {
  id        String   @id @default(uuid())
  optionId  String
  option    Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  color     String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("option_items")
}

// ============================================================
// UTILITY MODULE
// ============================================================

model Todo {
  id         String   @id @default(uuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  position   Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items TodoItem[]

  @@map("todos")
}

model TodoItem {
  id          String    @id @default(uuid())
  todoId      String
  todo        Todo      @relation(fields: [todoId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  position    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("todo_items")
}

model Backup {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  name      String
  filePath  String
  size      Int?
  type      String?  @default("manual")
  status    String   @default("Completed")
  createdAt DateTime @default(now())

  @@map("backups")
}

model ActivityLog {
  id          String   @id @default(uuid())
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  module      String?
  description String?
  modelType   String?
  modelId     String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

// ============================================================
// IMPORT / EXPORT MODULE
// ============================================================

model ImportJob {
  id            String    @id @default(uuid())
  type          String
  fileName      String
  filePath      String
  totalRows     Int?
  processedRows Int?      @default(0)
  failedRows    Int?      @default(0)
  status        String    @default("Pending")
  errors        Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@map("import_jobs")
}

model ExportJob {
  id          String    @id @default(uuid())
  type        String
  fileName    String?
  filePath    String?
  filters     Json?
  status      String    @default("Pending")
  startedAt   DateTime?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@map("export_jobs")
}
