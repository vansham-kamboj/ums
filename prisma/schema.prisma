  subjectIncharges   SubjectIncharge[]
  enquiriesAssigned  Enquiry[]               @relation("EnquiryAssigned")
  mentorStudents     Student[]               @relation("StudentMentor")
  complaintsAssigned ComplaintAssignee[]
  eventIncharges     EventIncharge[]

  @@map("employees")
}

