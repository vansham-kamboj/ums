  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("leave_requests")
}

// Payroll
model PayHead {
  id          String      @id @default(uuid())
  name        String
  code        String?
  type        PayHeadType
  isActive    Boolean     @default(true)
  isTaxable   Boolean     @default(false)
  computeType String?
  formula     String?
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  salaryTemplateRecords  SalaryTemplateRecord[]
  salaryStructureRecords SalaryStructureRecord[]
  payrollRecords         PayrollRecord[]

  @@map("pay_heads")
}

enum PayHeadType {
  EARNING
  DEDUCTION
  TOTAL
}

model SalaryTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records    SalaryTemplateRecord[]
  structures SalaryStructure[]

  @@map("salary_templates")
}

model SalaryTemplateRecord {
  id               String         @id @default(uuid())
  salaryTemplateId String
  salaryTemplate   SalaryTemplate @relation(fields: [salaryTemplateId], references: [id], onDelete: Cascade)
  payHeadId        String
  payHead          PayHead        @relation(fields: [payHeadId], references: [id])
  amount           Float?
  percentage       Float?
  computeOn        String?
  formula          String?
  position         Int            @default(0)
  createdAt        DateTime       @default(now())

  @@map("salary_template_records")
}

model SalaryStructure {
  id               String          @id @default(uuid())
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id])
  salaryTemplateId String?
  salaryTemplate   SalaryTemplate? @relation(fields: [salaryTemplateId], references: [id])
  effectiveDate    DateTime
  grossSalary      Float?
  netSalary        Float?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  records SalaryStructureRecord[]

  @@map("salary_structures")
}

model SalaryStructureRecord {
  id                String          @id @default(uuid())
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  payHeadId         String
  payHead           PayHead         @relation(fields: [payHeadId], references: [id])
  amount            Float
  createdAt         DateTime        @default(now())

  @@map("salary_structure_records")
}

model Payroll {
  id             String        @id @default(uuid())
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  month          Int
  year           Int
  totalEarning   Float         @default(0)
  totalDeduction Float         @default(0)
  netPay         Float         @default(0)
  status         PayrollStatus @default(DRAFT)
  processedAt    DateTime?
  paidAt         DateTime?
  remarks        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  records PayrollRecord[]

  @@unique([employeeId, month, year])
  @@map("payrolls")
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
  CANCELLED
}

model PayrollRecord {
  id        String   @id @default(uuid())
  payrollId String
  payroll   Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  payHeadId String
  payHead   PayHead  @relation(fields: [payHeadId], references: [id])
  amount    Float
  createdAt DateTime @default(now())

  @@map("payroll_records")
}

// Employee Ticket
model EmployeeTicket {
