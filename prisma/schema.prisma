  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  subject      String
  description  String?
  priority     String?  @default("Medium")
  status       String   @default("Open")
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages EmployeeTicketMessage[]

  @@map("employee_tickets")
}

model EmployeeTicketMessage {
  id        String         @id @default(uuid())
  ticketId  String
  ticket    EmployeeTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  message   String
  createdAt DateTime       @default(now())

  @@map("employee_ticket_messages")
}

// ============================================================
// FEE & FINANCE MODULE
// ============================================================

model FeeGroup {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  code        String?
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feeHeads FeeHead[]

  @@map("fee_groups")
}

model FeeHead {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  feeGroupId  String
  feeGroup    FeeGroup @relation(fields: [feeGroupId], references: [id])
  name        String
  code        String?
  description String?
  isTaxable   Boolean  @default(false)
  taxRate     Float?
  taxType     TaxType? @default(EXCLUSIVE)
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feeStructureComponents FeeStructureComponent[]
  feeInstallmentRecords  FeeInstallmentRecord[]
  feeConcessionRecords   FeeConcessionRecord[]
  studentFeeRecords      StudentFeeRecord[]

  @@map("fee_heads")
}

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
}

model FeeStructure {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id])
  name      String
  gender    Gender?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components   FeeStructureComponent[]
  installments FeeInstallment[]

  @@map("fee_structures")
}

model FeeStructureComponent {
  id             String       @id @default(uuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHeadId      String
  feeHead        FeeHead      @relation(fields: [feeHeadId], references: [id])
  amount         Float
  createdAt      DateTime     @default(now())

  @@map("fee_structure_components")
}

model FeeInstallment {
  id             String       @id @default(uuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  title          String
  dueDate        DateTime
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  records FeeInstallmentRecord[]

  @@map("fee_installments")
}

model FeeInstallmentRecord {
  id               String         @id @default(uuid())
  feeInstallmentId String
  feeInstallment   FeeInstallment @relation(fields: [feeInstallmentId], references: [id], onDelete: Cascade)
  feeHeadId        String
  feeHead          FeeHead        @relation(fields: [feeHeadId], references: [id])
  amount           Float
  createdAt        DateTime       @default(now())

  @@map("fee_installment_records")
}

model FeeConcession {
  id          String   @id @default(uuid())
  name        String
  code        String?
  type        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records FeeConcessionRecord[]

  @@map("fee_concessions")
}

model FeeConcessionRecord {
  id              String        @id @default(uuid())
  feeConcessionId String
  feeConcession   FeeConcession @relation(fields: [feeConcessionId], references: [id], onDelete: Cascade)
  feeHeadId       String
  feeHead         FeeHead       @relation(fields: [feeHeadId], references: [id])
  amount          Float?
  percentage      Float?
  createdAt       DateTime      @default(now())

  @@map("fee_concession_records")
}

model StudentFee {
  id               String        @id @default(uuid())
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  totalAmount      Float
  paidAmount       Float         @default(0)
  concessionAmount Float         @default(0)
  balanceAmount    Float         @default(0)
  status           PaymentStatus @default(PENDING)
  feeConcessionId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

